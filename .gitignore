# ==========================================
# 1. Python & Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version

# ==========================================
# 2. Ambientes Virtuais (Virtual Environments)
# ==========================================
sistema/venv/
sistema/.venv/
sistema/env/
sistema/ENV/
sistema/virtual/

# ==========================================
# 3. Django: Mídia, Estáticos e Banco de Dados Local
# ==========================================
# Banco de dados local (SQLite)
*.sqlite3
*.sqlite3-journal
*.db

# Uploads de fotos dos imóveis enviadas pelos usuários
/sistema/media/

# Arquivos estáticos gerados pelo 'collectstatic'
/staticfiles/
/static_root/

# Logs de erro e execução
*.log
/logs/

# ==========================================
# 4. Variáveis de Ambiente e Segredos (Segurança)
# ==========================================
.env
.env.local
.env.*.local
.env.example
secrets.json
local_settings.py

# ==========================================
# 5. Editores de Código e IDEs
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
*.code-workspace

# PyCharm / JetBrains
.idea/

# ==========================================
# 6. Arquivos do Sistema Operacional
# ==========================================
# macOS
.DS_Store
.AppleDouble

# Windows
Thumbs.db
Desktop.ini

# ==========================================
# 7. Testes e Cobertura
# ==========================================
.coverage
htmlcov/
.pytest_cache/